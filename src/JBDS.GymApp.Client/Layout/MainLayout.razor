@inherits LayoutComponentBase
@implements IDisposable
@inject GymAuthStateProvider Auth
@inject GymApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand-box">
            <div class="brand-title">
                @if (IsPlatformAdmin && !Auth.IsInOverrideMode)
                {
                    @:JBDS Platform Control
                }
                else
                {
                    @(Auth.OverrideTenantName ?? Auth.CurrentUser?.TenantName ?? "JBDS GymApp")
                }
            </div>
            <div class="brand-sub">
                @if (IsPlatformAdmin && !Auth.IsInOverrideMode)
                {
                    @:Multi-Product · Multi-Tenant Admin
                }
                else
                {
                    @(Auth.CurrentUser?.ProductName ?? "Multi-Tenant Gym PWA")
                }
            </div>
        </div>

        <nav class="nav-links" aria-label="Main Navigation">
            @if (IsPlatformAdmin)
            {
                <NavLink class="nav-link" href="platform" Match="NavLinkMatch.All">Platform Console</NavLink>

                @if (Auth.IsInOverrideMode)
                {
                    <div style="font-size:0.7rem; text-transform:uppercase; color:var(--warning); padding:0.55rem 0.85rem 0.15rem; font-weight:700; letter-spacing:0.05em;">
                        Tenant Override Controls
                    </div>
                    <NavLink class="nav-link" href="staff" Match="NavLinkMatch.All">Tenant Dashboard</NavLink>
                    <NavLink class="nav-link" href="checkin">Front Desk Check-In</NavLink>
                    <NavLink class="nav-link" href="doors">Live Door Monitor</NavLink>
                    <NavLink class="nav-link" href="members">Members</NavLink>
                    <NavLink class="nav-link" href="plans">Membership Plans</NavLink>
                    <NavLink class="nav-link" href="classes">Classes &amp; Schedule</NavLink>
                    <NavLink class="nav-link" href="pos">POS / Pro Shop</NavLink>
                    <NavLink class="nav-link" href="crm">Leads &amp; CRM</NavLink>
                    <NavLink class="nav-link" href="billing">Billing &amp; Stripe</NavLink>
                    <NavLink class="nav-link" href="reports">Reports &amp; Inbox</NavLink>
                    <NavLink class="nav-link" href="settings">Tenant Theme &amp; Settings</NavLink>
                    <NavLink class="nav-link" href="@($"t/{ActiveSlug}")">Public Website</NavLink>
                }
            }
            else if (IsTenantStaffOrAdmin)
            {
                <NavLink class="nav-link" href="staff" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink class="nav-link" href="checkin">Front Desk Check-In</NavLink>
                <NavLink class="nav-link" href="doors">Live Door Monitor</NavLink>
                <NavLink class="nav-link" href="members">Members</NavLink>
                <NavLink class="nav-link" href="plans">Membership Plans</NavLink>
                <NavLink class="nav-link" href="classes">Classes &amp; Schedule</NavLink>
                <NavLink class="nav-link" href="pos">POS / Pro Shop</NavLink>
                <NavLink class="nav-link" href="crm">Leads &amp; CRM</NavLink>
                <NavLink class="nav-link" href="billing">Billing &amp; Stripe</NavLink>
                <NavLink class="nav-link" href="reports">Reports &amp; Inbox</NavLink>
                @if (IsTenantAdmin)
                {
                    <NavLink class="nav-link" href="settings">Tenant Theme &amp; Settings</NavLink>
                }
                <NavLink class="nav-link" href="@($"t/{ActiveSlug}")">Public Branded Area</NavLink>
                <NavLink class="nav-link" href="member">Member Portal Preview</NavLink>
            }
            else if (Auth.CurrentUser is not null)
            {
                <NavLink class="nav-link" href="member" Match="NavLinkMatch.All">My Member Portal</NavLink>
                <NavLink class="nav-link" href="@($"t/{ActiveSlug}")">Club Home</NavLink>
            }
            else
            {
                <NavLink class="nav-link" href="t/superiorfitness">Superior Fitness</NavLink>
                <NavLink class="nav-link" href="t/southsidefitness">Southside Fitness</NavLink>
                <NavLink class="nav-link" href="t/ironforge">Iron Forge</NavLink>
                <NavLink class="nav-link" href="login">Portal Sign In</NavLink>
            }
        </nav>

        <div class="card" style="padding: 0.75rem; font-size: 0.8rem;">
            @if (Auth.CurrentUser is not null)
            {
                <div style="font-weight:600;">@Auth.CurrentUser.FullName</div>
                <div style="color:var(--text-secondary); margin-bottom:0.5rem;">@string.Join(", ", Auth.CurrentUser.Roles)</div>
                <button class="btn btn-secondary btn-sm" style="width:100%;" @onclick="HandleLogout">Sign Out</button>
            }
            else
            {
                <a class="btn btn-primary btn-sm" style="width:100%;" href="login">Sign In</a>
            }
        </div>
    </aside>

    <div class="main-column">
        @if (Auth.IsInOverrideMode)
        {
            <div style="background:rgba(245,158,11,0.18); border-bottom:1px solid rgba(245,158,11,0.45); color:#fde68a; padding:0.6rem 1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; font-size:0.85rem;">
                <div>
                    <strong>PLATFORM OVERRIDE MODE:</strong> Viewing &amp; administering tenant <strong>@Auth.OverrideTenantName</strong> (<code>@Auth.ActiveTenantSlug</code>)
                </div>
                <button class="btn btn-secondary btn-sm" @onclick="ExitOverrideAsync">Exit to Platform Console</button>
            </div>
        }

        <header class="topbar">
            <div>
                @if (IsPlatformAdmin && !Auth.IsInOverrideMode)
                {
                    <span class="badge badge-amber">Scope: Platform Control Plane</span>
                }
                else
                {
                    <span class="badge badge-blue">Tenant: @ActiveSlug</span>
                    <span class="badge badge-green" style="margin-left:0.4rem;">Product: @(Auth.CurrentUser?.ProductKey ?? "gym-membership")</span>
                }
            </div>
            <div style="font-size:0.84rem; color:var(--text-secondary);">
                @(Auth.CurrentUser?.Email ?? "Public Visitor")
            </div>
        </header>

        <main class="content-area">
            @Body
        </main>

        <footer class="app-footer">
            <div class="jbds-credit">
                v@BuildMetadata.Version · @BuildMetadata.DeployDate · Powered by
                <a href="https://jbdigitalservices.net" target="_blank" rel="noopener noreferrer">JB Digital Services</a>
            </div>
        </footer>
    </div>
</div>

@code {
    private bool IsPlatformAdmin => Auth.CurrentUser?.IsPlatformAdmin == true;
    private bool IsTenantAdmin => Auth.CurrentUser?.Roles.Contains("TenantAdmin") == true;
    private bool IsTenantStaffOrAdmin =>
        Auth.CurrentUser is not null &&
        Auth.CurrentUser.Roles.Any(r => r is "TenantAdmin" or "Staff" or "Trainer");
    private string ActiveSlug => Auth.ActiveTenantSlug ?? Auth.CurrentUser?.TenantSlug ?? "superiorfitness";

    protected override async Task OnInitializedAsync()
    {
        Auth.StateChanged += HandleStateChanged;
        await ApplyActiveTenantThemeAsync();
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ApplyActiveTenantThemeAsync();
            StateHasChanged();
        });
    }

    private async Task ApplyActiveTenantThemeAsync()
    {
        try
        {
            var branding = await Api.GetBrandingAsync();
            if (branding is not null)
            {
                await JS.InvokeVoidAsync("jbdsTheme.apply", branding.ThemePreset, branding.PrimaryColor, branding.AccentColor);
            }
        }
        catch
        {
            // Ignore transient theme load errors
        }
    }

    private async Task ExitOverrideAsync()
    {
        await Auth.ExitOverrideModeAsync();
        Nav.NavigateTo("/platform");
    }

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Auth.StateChanged -= HandleStateChanged;
    }
}
