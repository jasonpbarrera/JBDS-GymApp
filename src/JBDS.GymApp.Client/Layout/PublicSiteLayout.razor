@inherits LayoutComponentBase
@implements IDisposable
@inject GymAuthStateProvider Auth
@inject GymApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<div style="min-height:100vh; display:flex; flex-direction:column; background:var(--bg-base); color:var(--text-primary); font-family:@BodyFont;">
    <!-- Full-width Branded Public Navbar -->
    <header style="position:sticky; top:0; z-index:50; background:@HeaderBg; border-bottom:1px solid @HeaderBorder;">
        <div style="max-width:1260px; margin:0 auto; padding:0.75rem 1.5rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <a href="@($"/t/{RouteSlug}")" style="display:flex; align-items:center; gap:0.7rem; color:#ffffff; text-decoration:none;">
                @if (!string.IsNullOrWhiteSpace(LogoUrl))
                {
                    <img src="@LogoUrl" alt="@DisplayName" style="height:44px; width:auto; object-fit:contain; border-radius:4px;" />
                }
                <span style="font-family:@HeadingFont; font-weight:800; font-size:1.15rem; letter-spacing:0.04em; text-transform:uppercase;">@DisplayName</span>
            </a>

            <nav style="display:flex; align-items:center; gap:1.15rem; flex-wrap:wrap; font-size:0.86rem; font-weight:600; text-transform:uppercase; letter-spacing:0.04em;">
                @if (RouteSlug == "southsidefitness")
                {
                    <a href="/t/southsidefitness#about" style="color:#e4e4e7;">About Us</a>
                    <a href="/t/southsidefitness#classes" style="color:#e4e4e7;">Classes</a>
                    <a href="/t/southsidefitness#memberships" style="color:#e4e4e7;">Pricing</a>
                    <a href="/t/southsidefitness#training" style="color:#e4e4e7;">Coaching &amp; GP Athletes</a>
                    <a href="/login" style="color:#ffffff; border:1px solid rgba(255,255,255,0.3); padding:0.42rem 0.85rem; border-radius:6px;">Log In</a>
                    <a href="/join/southsidefitness" style="background:#dc2f33; color:#ffffff; padding:0.46rem 0.95rem; border-radius:6px; text-decoration:none;">Join Today</a>
                }
                else
                {
                    <a href="@($"/t/{RouteSlug}#about")" style="color:#e5e7eb;">About</a>
                    <a href="@($"/t/{RouteSlug}#reviews")" style="color:#e5e7eb;">Reviews</a>
                    <a href="@($"/t/{RouteSlug}#memberships")" style="color:#e5e7eb;">Memberships</a>
                    <a href="@($"/t/{RouteSlug}#training")" style="color:#e5e7eb;">1-on-1 Training</a>
                    <a href="/login" style="color:#ffffff; border:1px solid rgba(255,255,255,0.3); padding:0.42rem 0.85rem; border-radius:6px;">Portal Login</a>
                    <a href="@($"/join/{RouteSlug}")" style="background:#de1d1d; color:#ffffff; padding:0.46rem 0.95rem; border-radius:6px; text-decoration:none;">Join Now</a>
                }
            </nav>
        </div>
    </header>

    <!-- Full-Bleed Main Body -->
    <main style="flex:1; width:100%;">
        @Body
    </main>

    <!-- Public Website Footer with Portal Links + Local Gym Pitch Switcher -->
    <footer style="background:#111113; color:#a1a1aa; border-top:1px solid rgba(255,255,255,0.1);">
        <div style="max-width:1260px; margin:0 auto; padding:1.75rem 1.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
            <div style="display:flex; gap:1rem; flex-wrap:wrap; font-size:0.84rem;">
                <a href="/login" style="color:#e4e4e7;">Member Portal</a>
                <span>·</span>
                <a href="/login" style="color:#e4e4e7;">Staff &amp; Trainer Portal</a>
                <span>·</span>
                <a href="/login" style="color:#e4e4e7;">Platform Admin</a>
            </div>
            <div style="display:flex; gap:0.75rem; align-items:center; flex-wrap:wrap; font-size:0.8rem;">
                <span style="color:#71717a;">Switch Local Gym Site:</span>
                <a href="/t/superiorfitness" style="color:@(RouteSlug=="superiorfitness"?"#f87171":"#e4e4e7"); font-weight:@(RouteSlug=="superiorfitness"?"700":"400");">Superior Fitness Cleveland</a>
                <span>·</span>
                <a href="/t/southsidefitness" style="color:@(RouteSlug=="southsidefitness"?"#f87171":"#e4e4e7"); font-weight:@(RouteSlug=="southsidefitness"?"700":"400");">Southside Fitness</a>
                <span>·</span>
                <a href="/t/ironforge" style="color:@(RouteSlug=="ironforge"?"#34d399":"#e4e4e7"); font-weight:@(RouteSlug=="ironforge"?"700":"400");">Iron Forge</a>
            </div>
        </div>
        <div style="max-width:1260px; margin:0 auto; padding:0 1.5rem 1rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
            <div style="font-size:0.75rem; color:#71717a;">© @DateTime.UtcNow.Year @DisplayName — All Rights Reserved.</div>
            <div class="jbds-credit" style="color:#a1a1aa;">
                v@BuildMetadata.Version · @BuildMetadata.DeployDate · Powered by
                <a href="https://jbdigitalservices.net" target="_blank" rel="noopener noreferrer">JB Digital Services</a>
            </div>
        </div>
    </footer>
</div>

@code {
    private string RouteSlug { get; set; } = "superiorfitness";

    private string DisplayName => RouteSlug switch
    {
        "southsidefitness" => "Southside Fitness",
        "ironforge" => "Iron Forge Fitness",
        _ => "Superior Fitness Cleveland"
    };

    private string? LogoUrl => RouteSlug switch
    {
        "southsidefitness" => "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4ef2629c69f1e5b4bf78_website-logo-large-1.png",
        "superiorfitness" => "https://img1.wsimg.com/isteam/ip/ac960418-e0fe-42a7-9545-1f31a4955ead/superior%20fitness%20logo%20new.webp",
        _ => null
    };

    private string HeaderBg => RouteSlug switch
    {
        "southsidefitness" => "#1c1c1c",
        "superiorfitness" => "#000000",
        _ => "#111827"
    };

    private string HeaderBorder => RouteSlug switch
    {
        "southsidefitness" => "rgba(220,47,51,0.35)",
        "superiorfitness" => "rgba(222,29,29,0.45)",
        _ => "rgba(148,163,184,0.16)"
    };

    private string HeadingFont => RouteSlug switch
    {
        "southsidefitness" => "'Oswald', Impact, sans-serif",
        "superiorfitness" => "'Fjalla One', sans-serif",
        _ => "inherit"
    };

    private string BodyFont => RouteSlug switch
    {
        "southsidefitness" => "'Open Sans', sans-serif",
        "superiorfitness" => "'Montserrat', sans-serif",
        _ => "inherit"
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
        SyncSlugFromUrl();
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncSlugFromUrl();
        InvokeAsync(StateHasChanged);
    }

    private void SyncSlugFromUrl()
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        var parts = rel.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2 && (parts[0].Equals("t", StringComparison.OrdinalIgnoreCase) || parts[0].Equals("join", StringComparison.OrdinalIgnoreCase)))
        {
            RouteSlug = parts[1].ToLowerInvariant();
        }
        else if (!string.IsNullOrWhiteSpace(Auth.ActiveTenantSlug) && parts.Length > 0 && parts[0].Equals("login", StringComparison.OrdinalIgnoreCase))
        {
            RouteSlug = Auth.ActiveTenantSlug.ToLowerInvariant();
        }
        else
        {
            RouteSlug = "superiorfitness";
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
