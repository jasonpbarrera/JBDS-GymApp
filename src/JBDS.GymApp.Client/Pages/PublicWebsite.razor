                     style="width:100%; max-height:420px; object-fit:cover; border-radius:10px; box-shadow:0 18px 36px rgba(0,0,0,0.14);" />
            </div>
        </div>
    </section>

    <!-- WHAT OUR CLIENTS SAY — 5.0 Stars (130 Reviews) on Soft Gray #ede8e8 -->
