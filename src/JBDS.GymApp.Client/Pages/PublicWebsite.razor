@page "/"
@page "/t/{TenantSlug}"
@layout PublicSiteLayout
@inject GymApiClient Api
@inject GymAuthStateProvider Auth
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@(_info?.TenantName ?? "Superior Fitness Cleveland") — 24/7 Gym &amp; Personal Training</PageTitle>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div style="max-width:1200px; margin:1rem auto; padding:0 1.5rem;">
        <div class="alert alert-error">@_error</div>
    </div>
}

@if (_info is null)
{
    <div style="max-width:1200px; margin:2rem auto; padding:0 1.5rem;">
        <div class="card">Loading gym website...</div>
    </div>
}
else if (_info.TenantSlug == "southsidefitness")
{
    <!-- ========================================================================= -->
    <!-- SOUTHSIDE FITNESS CLEVELAND — Authentic Webflow-Inspired Layout & Graphics -->
    <!-- ========================================================================= -->
    <section style="position:relative; min-height:540px; display:flex; align-items:center; background: linear-gradient(90deg, rgba(12,12,14,0.88) 0%, rgba(12,12,14,0.62) 55%, rgba(220,47,51,0.28) 100%), url('https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fa891ee7ad4f04944db_Image.png') center/cover no-repeat;">
        <div style="max-width:1200px; width:100%; margin:0 auto; padding:4.5rem 1.5rem;">
            <div style="max-width:700px;">
                <div style="color:#dc2f33; font-family:'Oswald',Impact,sans-serif; font-weight:700; letter-spacing:0.18em; font-size:0.95rem; text-transform:uppercase; margin-bottom:0.6rem;">
                    SOUTHSIDE FITNESS CLEVELAND
                </div>
                <h1 style="margin:0 0 1rem; font-family:'Oswald',Impact,sans-serif; font-size:clamp(2.4rem, 5.5vw, 4rem); font-weight:700; line-height:1.04; text-transform:uppercase; color:#ffffff; letter-spacing:0.01em;">
                    YOUR PREMIER LOCAL FITNESS CENTER IN CLEVELAND, TN
                </h1>
                <p style="margin:0 0 1.75rem; color:#e4e4e7; font-size:1.05rem; line-height:1.6;">
                    Old school feel with modern results. 24/7 Access · Powerlifting · HIIT · Muay Thai · Kickboxing · GP Athletes Youth Programs.
                </p>
                <div style="display:flex; gap:0.85rem; flex-wrap:wrap;">
                    <a class="btn" style="background:#dc2f33; color:#ffffff; padding:0.85rem 1.75rem; font-family:'Oswald',sans-serif; font-size:1rem; letter-spacing:0.08em; text-transform:uppercase;" href="/t/southsidefitness#visit">REGISTER FOR A DAY PASS</a>
                    <a class="btn" style="background:rgba(255,255,255,0.12); color:#ffffff; border:1px solid rgba(255,255,255,0.4); padding:0.85rem 1.5rem; font-family:'Oswald',sans-serif; font-size:1rem; letter-spacing:0.08em; text-transform:uppercase;" href="/join/southsidefitness">JOIN TODAY</a>
                </div>
            </div>
        </div>
    </section>

    <!-- OUR GYM Section (2-column split with real Southside gym photos) -->
    <section id="about" style="background:#1c1c1c; padding:4rem 1.5rem; border-top:3px solid #dc2f33;">
        <div style="max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:2.25rem; align-items:center;">
            <div>
                <div style="color:#dc2f33; font-family:'Oswald',sans-serif; font-size:0.9rem; letter-spacing:0.16em; text-transform:uppercase;">24 / 7 · 511 S LEE HWY, CLEVELAND, TN 37311</div>
                <h2 style="margin:0.35rem 0 1rem; font-family:'Oswald',Impact,sans-serif; font-size:2.4rem; text-transform:uppercase; color:#ffffff;">OUR GYM</h2>
                <p style="color:#d4d4d8; font-size:1rem; line-height:1.7; margin-bottom:1.35rem;">
                    Cleveland's premier athletic complex offering a wide variety of fitness options for everyone. Old school feel with modern results. Family owned and operated offering power lifting, HIIT classes, Muay Thai, Kickboxing, DanzFit, and other options to meet your fitness needs.
                </p>
                <a class="btn" style="background:#dc2f33; color:#ffffff; padding:0.75rem 1.45rem; font-family:'Oswald',sans-serif; letter-spacing:0.08em; text-transform:uppercase;" href="/t/southsidefitness#visit">BOOK A DAY PASS</a>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                <img src="https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fa7d663976f9419c04a_Image.png" alt="Southside Fitness Floor" style="width:100%; height:190px; object-fit:cover; border-radius:8px;" />
                <img src="https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fa93d098b9aa66d779b_Image.png" alt="Southside Weight Room" style="width:100%; height:190px; object-fit:cover; border-radius:8px;" />
                <img src="https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4faa073ed8ceb0e03bc1_Image.png" alt="Southside Powerlifting" style="width:100%; height:190px; object-fit:cover; border-radius:8px;" />
                <img src="https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fab05ea5c87f501a179_Image.png" alt="Southside Turf" style="width:100%; height:190px; object-fit:cover; border-radius:8px;" />
            </div>
        </div>
    </section>

    <!-- CLASSES Photo Grid (6 Real Southside Class Photos) -->
    <section id="classes" style="background:#121214; padding:4rem 1.5rem;">
        <div style="max-width:1200px; margin:0 auto;">
            <div style="text-align:center; max-width:680px; margin:0 auto 2.25rem;">
                <div style="color:#dc2f33; font-family:'Oswald',sans-serif; letter-spacing:0.15em; font-size:0.9rem; text-transform:uppercase;">MORNING &amp; EVENING CLASSES</div>
                <h2 style="margin:0.3rem 0 0.6rem; font-family:'Oswald',Impact,sans-serif; font-size:2.4rem; text-transform:uppercase; color:#ffffff;">CLASSES</h2>
                <p style="color:#a1a1aa; margin:0;">We offer a range of classes for every fitness level and age range! Come give them a shot and book directly in your Member Portal.</p>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(300px, 1fr)); gap:1.25rem;">
                @foreach (var cls in _southsideClasses)
                {
                    <div style="background:#1c1c1c; border:1px solid rgba(255,255,255,0.08); border-radius:10px; overflow:hidden; display:flex; flex-direction:column;">
                        <img src="@cls.ImageUrl" alt="@cls.Title" style="width:100%; height:200px; object-fit:cover;" />
                        <div style="padding:1.25rem; flex:1;">
                            <h3 style="margin:0 0 0.45rem; font-family:'Oswald',sans-serif; font-size:1.3rem; text-transform:uppercase; color:#dc2f33;">@cls.Title</h3>
                            <p style="margin:0; color:#d4d4d8; font-size:0.88rem; line-height:1.6;">@cls.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- MEMBERSHIP PRICING (LIFT $25, GP + Parent $170 Featured, HIIT $40) -->
    <section id="memberships" style="background: linear-gradient(rgba(18,18,20,0.92), rgba(18,18,20,0.95)), url('https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d50ec788891d494f66387_Image-Wrapper.png') center/cover no-repeat; padding:4.25rem 1.5rem;">
        <div style="max-width:1120px; margin:0 auto;">
            <div style="text-align:center; margin-bottom:2.25rem;">
                <div style="color:#dc2f33; font-family:'Oswald',sans-serif; letter-spacing:0.15em; font-size:0.9rem; text-transform:uppercase;">NO CONTRACTS · 24/7 ACCESS</div>
                <h2 style="margin:0.3rem 0 0; font-family:'Oswald',Impact,sans-serif; font-size:2.4rem; text-transform:uppercase; color:#ffffff;">MEMBERSHIP PRICING</h2>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem; align-items:stretch;">
                @foreach (var p in _info.Plans)
                {
                    var isFeatured = p.Name.Contains("GP", StringComparison.OrdinalIgnoreCase);
                    <div style="background:@(isFeatured ? "#212121" : "#18181b"); border:@(isFeatured ? "2px solid #dc2f33" : "1px solid rgba(255,255,255,0.12)"); border-radius:12px; padding:2rem 1.5rem; display:flex; flex-direction:column; justify-content:space-between; text-align:center;">
                        <div>
                            <img src="@(isFeatured ? "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d50edaacf6b06b254bb51_pricing-2.png" : "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/666148388e701b3e00746573_SF_256x256.png")"
                                 alt="@p.Name" style="height:64px; width:auto; object-fit:contain; margin-bottom:0.85rem;" />
                            <h3 style="margin:0; font-family:'Oswald',sans-serif; font-size:1.65rem; text-transform:uppercase; color:#ffffff;">@p.Name</h3>
                            <div style="font-family:'Oswald',sans-serif; font-size:2.75rem; font-weight:700; color:#dc2f33; margin:0.4rem 0;">$@p.Price.ToString("N0")</div>
                            <div style="font-size:0.82rem; text-transform:uppercase; letter-spacing:0.1em; color:#a1a1aa; margin-bottom:1.1rem;">@p.BillingInterval</div>
                            <p style="color:#d4d4d8; font-size:0.88rem; line-height:1.65; text-align:left;">@p.Description</p>
                        </div>
                        <a class="btn" style="width:100%; background:#dc2f33; color:#ffffff; padding:0.75rem; font-family:'Oswald',sans-serif; letter-spacing:0.08em; text-transform:uppercase; margin-top:1.25rem;" href="/join/southsidefitness">JOIN TODAY</a>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- COACHING & 4-CARD SHOWCASE + DAY PASS FORM -->
    <section id="training" style="background:#1c1c1c; padding:4rem 1.5rem;">
        <div style="max-width:1200px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:2rem; align-items:center; margin-bottom:3rem;">
            <img src="https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d52a2424d40aa87581bab_Image.png" alt="Southside Coaching" style="width:100%; height:340px; object-fit:cover; border-radius:10px;" />
            <div>
                <div style="color:#dc2f33; font-family:'Oswald',sans-serif; letter-spacing:0.15em; font-size:0.9rem; text-transform:uppercase;">PERSONAL TRAINING &amp; GP ATHLETES</div>
                <h2 style="margin:0.35rem 0 0.85rem; font-family:'Oswald',Impact,sans-serif; font-size:2.3rem; text-transform:uppercase; color:#ffffff;">COACHING</h2>
                <p style="color:#d4d4d8; line-height:1.7; font-size:0.96rem;">
                    Coaching offers accountability, expertise, and motivation. Working with a certified Southside coach maximizes workout efficiency, reduces injury risk, and adapts to every age and fitness level — including <strong>GP Athletes</strong> youth speed, agility, power, and strength development.
                </p>
                <div style="margin-top:1rem; font-size:0.9rem; color:#e4e4e7; line-height:1.7;">
                    <strong>511 S Lee Hwy, Cleveland, TN 37311</strong> · <strong>(423) 458-1900</strong>
                </div>
            </div>
        </div>

        <div style="max-width:1200px; margin:0 auto;">
            @RenderDayPassForm("REGISTER FOR A SOUTHSIDE DAY PASS", "#dc2f33")
        </div>
    </section>
}
else if (_info.TenantSlug == "superiorfitness")
{
