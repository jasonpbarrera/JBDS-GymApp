            <h1 style="margin:0 0 1rem; font-family:'Fjalla One',sans-serif; font-size:clamp(2.5rem, 5.5vw, 4.1rem); text-transform:uppercase; line-height:1.08; color:#ffffff; letter-spacing:0.02em;">
