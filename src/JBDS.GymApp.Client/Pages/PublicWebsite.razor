            <h1 style="margin:0 0 0.75rem; font-size:2.4rem;">@_info.TenantName</h1>
            <p style="color:var(--text-secondary); font-size:1.05rem;">@_info.HeroTagline</p>
            <div style="display:flex; gap:0.75rem; margin-top:1.25rem;">
                <a class="btn btn-primary" href="@($"/join/{_info.TenantSlug}")">Join Online</a>
                <a class="btn btn-secondary" href="/login">Portal Sign In</a>
            </div>
        </div>
        @RenderDayPassForm("REQUEST A FREE DAY PASS", "var(--brand-primary)")
    </section>
}

@if (_info is not null)
{
    <!-- Credential-Free Portal Role Simulator Bar (for pitching & testing) -->
    <section style="background:#0f172a; color:#f8fafc; padding:1.5rem; border-top:1px solid rgba(255,255,255,0.12);">
        <div style="max-width:1200px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.85rem;">
            <div>
                <div style="font-weight:700; font-size:0.92rem;">Interactive Pitch &amp; Portal Simulator — @_info.TenantName</div>
                <div style="font-size:0.8rem; color:#94a3b8;">Preview this gym's Member Portal (24/7 Door Unlock), Front Desk Staff Portal, Owner Controls, or Platform Admin—zero passwords needed.</div>
            </div>
            <div style="display:flex; gap:0.45rem; flex-wrap:wrap;">
                <button class="btn btn-primary btn-sm" style="background:#dc2f33; color:#fff;" disabled="@_simBusy" @onclick='() => SimulateRoleAsync("Member")'>Simulate Member</button>
                <button class="btn btn-secondary btn-sm" style="background:#1e293b; color:#fff;" disabled="@_simBusy" @onclick='() => SimulateRoleAsync("Staff")'>Simulate Staff</button>
                <button class="btn btn-secondary btn-sm" style="background:#1e293b; color:#fff;" disabled="@_simBusy" @onclick='() => SimulateRoleAsync("TenantAdmin")'>Simulate Gym Owner</button>
                <button class="btn btn-secondary btn-sm" style="background:#1e293b; color:#fff;" disabled="@_simBusy" @onclick='() => SimulateRoleAsync("PlatformAdmin")'>Simulate Platform Admin</button>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string? TenantSlug { get; set; }

    private sealed record ClassCard(string Title, string Description, string ImageUrl);

    private readonly List<ClassCard> _southsideClasses =
    [
        new("BEARDFIT", "Want to sweat? Want to burn calories and build muscle? Come check out this amazing class with our instructor David!", "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/666327a1be90a35c0a8725df_Beardfit_400x300.png"),
        new("FITNESS WITH KAM", "An invigorating HIIT class tailored for all fitness levels, fostering a supportive and motivating atmosphere.", "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fe679a786a50073351e_Image.png"),
        new("MUSCLE MCCOY BOOT CAMP", "Our instructor Mark will push you to reach your full potential, ensuring you surpass your limits and achieve your goals.", "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fe6dce1a011b1a773a3_Image.png"),
        new("MUAY THAI", "Thai boxing full-contact combat sport using stand-up striking, sweeps, and various clinching techniques.", "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fe7e496ccc5318fb771_Image.png"),
        new("KICK BOXING CARDIO", "High intensity cardio based kickboxing to increase cardiovascular health, burn fat, and build strength.", "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/665d4fe8bc96d4906ba7258c_Image.png"),
        new("GLOW UP FITNESS", "A jam-packed party blending cardio, toning, strength, and balance with a groovy beat — judgment-free zone!", "https://cdn.prod.website-files.com/665d4e5509c5543555d770cf/66b1832e710f208104416453_400x300_glowup.png")
    ];

    private PublicJoinInfoDto? _info;
    private string _leadName = string.Empty;
    private string _leadEmail = string.Empty;
    private string _leadPhone = string.Empty;
    private string _leadNotes = string.Empty;
    private bool _sendingLead;
    private bool _simBusy;
    private string? _leadMsg;
    private string? _error;

    private RenderFragment RenderDayPassForm(string heading, string btnColor) => __builder =>
    {
        <div id="visit" class="card" style="background:var(--bg-surface); color:var(--text-primary);">
            <h2 style="margin-top:0; font-size:1.35rem; text-transform:uppercase;">@heading</h2>
            <p style="color:var(--text-secondary); font-size:0.86rem; margin-top:0;">Submits directly into the gym's front-desk CRM pipeline.</p>

            @if (!string.IsNullOrWhiteSpace(_leadMsg))
            {
                <div class="alert alert-success">@_leadMsg</div>
            }

            <div class="form-grid" style="margin-bottom:0.75rem;">
                <div class="field"><label>Full Name</label><input class="input" @bind="_leadName" placeholder="Your Name" /></div>
                <div class="field"><label>Email</label><input class="input" type="email" @bind="_leadEmail" placeholder="you@example.com" /></div>
                <div class="field"><label>Phone</label><input class="input" @bind="_leadPhone" placeholder="(423) 555-0199" /></div>
            </div>
            <div class="field" style="margin-bottom:0.85rem;">
                <label>What are you interested in?</label>
                <input class="input" @bind="_leadNotes" placeholder="Free day pass, 24/7 membership, classes, or 1-on-1 training" />
            </div>
            <button class="btn" style="background:@btnColor; color:#ffffff; padding:0.7rem 1.4rem; font-weight:700;" disabled="@_sendingLead" @onclick="SubmitLeadAsync">
                @(_sendingLead ? "Sending..." : "Request Free Day Pass")
            </button>
        </div>
    };

    protected override async Task OnParametersSetAsync()
    {
        _error = _leadMsg = null;
        try
        {
            var slug = string.IsNullOrWhiteSpace(TenantSlug) ? "superiorfitness" : TenantSlug.Trim().ToLowerInvariant();
            await Auth.SetActiveTenantSlugAsync(slug);

            _info = await Api.GetPublicJoinInfoAsync(slug);
            if (_info is not null)
            {
                await JS.InvokeVoidAsync("jbdsTheme.apply", _info.ThemePreset, _info.PrimaryColor, _info.AccentColor);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SubmitLeadAsync()
    {
        if (_info is null) return;
        _sendingLead = true;
        _error = _leadMsg = null;
        try
        {
            await Api.SubmitPublicLeadAsync(_info.TenantSlug, new CreateProspectLeadRequest(_leadName, _leadEmail, _leadPhone, "Public Website", _leadNotes));
            _leadName = _leadEmail = _leadPhone = _leadNotes = string.Empty;
            _leadMsg = $"Thanks! {_info.TenantName} received your request for a free day pass.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sendingLead = false; }
    }

    private async Task SimulateRoleAsync(string role)
    {
        if (_info is null) return;
        _simBusy = true;
        _error = null;
        try
        {
            var res = await Api.DemoLoginAsync(new DemoLoginRequest(role, _info.TenantSlug));
            if (res is not null)
            {
                await Auth.SetSessionAsync(res);
                if (res.User.IsPlatformAdmin) Nav.NavigateTo("/platform", forceLoad: false);
                else if (res.User.Roles.Any(r => r is "TenantAdmin" or "Staff" or "Trainer")) Nav.NavigateTo("/staff", forceLoad: false);
                else Nav.NavigateTo("/member", forceLoad: false);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _simBusy = false; }
    }
}
