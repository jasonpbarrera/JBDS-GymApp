@page "/login"
@layout PublicSiteLayout
@inject GymApiClient Api
@inject GymAuthStateProvider Auth
@inject NavigationManager Nav

<PageTitle>Portal Sign In — JBDS GymApp</PageTitle>

<div class="card" style="max-width:500px; margin:1.5rem auto;">
    <h1 style="margin-top:0; font-size:1.5rem;">Portal Sign In</h1>
    <p style="color:var(--text-secondary); font-size:0.88rem;">
        Sign in to your Member Portal, Staff &amp; Trainer Portal, or Platform Admin Console.
    </p>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-error">@_error</div>
    }

    <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
        <button class="btn @(!_isRegister ? "btn-primary" : "btn-secondary") btn-sm" @onclick="() => _isRegister = false">Sign In</button>
        <button class="btn @(_isRegister ? "btn-primary" : "btn-secondary") btn-sm" @onclick="() => _isRegister = true">Create Member Account</button>
    </div>

    <div class="field" style="margin-bottom:0.85rem;">
        <label>Gym Club</label>
        <select class="select" @bind="_tenantSlug">
            @if (_branding is not null && _branding.AvailableTenants.Count > 0)
            {
                @foreach (var t in _branding.AvailableTenants)
                {
                    <option value="@t.Slug">@t.Name</option>
                }
            }
            else
            {
                <option value="superiorfitness">Superior Fitness Cleveland</option>
                <option value="southsidefitness">Southside Fitness</option>
                <option value="ironforge">Iron Forge Fitness</option>
            }
        </select>
    </div>

    @if (_isRegister)
    {
        <div class="field" style="margin-bottom:0.85rem;">
            <label>Full Name</label>
            <input class="input" @bind="_fullName" placeholder="Your Full Name" />
        </div>
        <div class="field" style="margin-bottom:0.85rem;">
            <label>Phone</label>
            <input class="input" @bind="_phone" placeholder="(423) 555-0199" />
        </div>
    }

    <div class="field" style="margin-bottom:0.85rem;">
        <label>Email</label>
        <input class="input" type="email" @bind="_email" placeholder="you@example.com" />
    </div>

    <div class="field" style="margin-bottom:1.1rem;">
        <label>Password</label>
        <input class="input" type="password" @bind="_password" placeholder="Enter your password" />
    </div>

    <button class="btn btn-primary" style="width:100%;" disabled="@_busy" @onclick="SubmitAsync">
        @(_busy ? "Signing In..." : (_isRegister ? "Create Account" : "Sign In"))
    </button>

    <div style="margin-top:1.35rem; padding-top:1rem; border-top:1px solid var(--border-subtle); font-size:0.8rem; color:var(--text-secondary);">
        <div style="font-weight:700; color:var(--text-primary); margin-bottom:0.3rem;">Simulate Portal Login (Design &amp; Testing)</div>
        <div style="font-size:0.76rem; margin-bottom:0.65rem;">
            Preview any role for the selected club above—no credentials required.
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem;">
            <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick='() => SimulateAsync("Member")'>
                Simulate: Member
            </button>
            <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick='() => SimulateAsync("Staff")'>
                Simulate: Staff / Desk
            </button>
            <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick='() => SimulateAsync("TenantAdmin")'>
                Simulate: Gym Owner
            </button>
            <button type="button" class="btn btn-secondary btn-sm" disabled="@_busy" @onclick='() => SimulateAsync("PlatformAdmin")'>
                Simulate: Platform Admin
            </button>
        </div>
    </div>
</div>

@code {
    private TenantBrandingDto? _branding;
    private bool _isRegister;
    private bool _busy;
    private string? _error;

    private string _tenantSlug = "superiorfitness";
    private string _fullName = string.Empty;
    private string _phone = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _branding = await Api.GetBrandingAsync();
            if (!string.IsNullOrWhiteSpace(Auth.ActiveTenantSlug))
            {
                _tenantSlug = Auth.ActiveTenantSlug;
            }
            else if (_branding is not null)
            {
                _tenantSlug = _branding.TenantSlug;
            }
        }
        catch { }
    }

    private async Task SimulateAsync(string role)
    {
        _busy = true;
        _error = null;
        try
        {
            var res = await Api.DemoLoginAsync(new DemoLoginRequest(role, _tenantSlug));
            if (res is not null)
            {
                await RouteAfterLoginAsync(res);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var slug = string.IsNullOrWhiteSpace(_tenantSlug) ? null : _tenantSlug;
            AuthResponse? result = _isRegister
                ? await Api.RegisterAsync(new RegisterRequest(_fullName, _email, _password, _phone, slug))
                : await Api.LoginAsync(new LoginRequest(_email, _password, slug));

            if (result is not null)
            {
                await RouteAfterLoginAsync(result);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RouteAfterLoginAsync(AuthResponse result)
    {
        await Auth.SetSessionAsync(result);
        if (result.User.IsPlatformAdmin)
        {
            Nav.NavigateTo("/platform", forceLoad: false);
        }
        else if (result.User.Roles.Any(r => r is "TenantAdmin" or "Staff" or "Trainer"))
        {
            Nav.NavigateTo("/staff", forceLoad: false);
        }
        else
        {
            Nav.NavigateTo("/member", forceLoad: false);
        }
    }
}
