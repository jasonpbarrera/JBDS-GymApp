@page "/plans"
@attribute [Authorize]
@inject GymApiClient Api

<PageTitle>Membership Plans — JBDS GymApp</PageTitle>

<h1 style="margin-top:0; font-size:1.5rem;">Membership Plans</h1>

@if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert alert-success">@_message</div> }
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-error">@_error</div> }

<section class="card" style="margin-bottom:1.25rem;">
    <h2 style="margin-top:0; font-size:1.05rem;">Create Membership Plan</h2>
    <div class="form-grid">
        <div class="field"><label>Plan Name</label><input class="input" @bind="_name" placeholder="24/7 All-Access" /></div>
        <div class="field"><label>Price (USD)</label><input class="input" type="number" step="0.01" @bind="_price" /></div>
        <div class="field">
            <label>Billing Interval</label>
            <select class="select" @bind="_interval">
                @foreach (var val in Enum.GetValues<BillingInterval>())
                {
                    <option value="@val">@val</option>
                }
            </select>
        </div>
        <div class="field"><label>Description</label><input class="input" @bind="_description" placeholder="Unlimited access + group classes" /></div>
    </div>
    <button class="btn btn-primary" style="margin-top:0.85rem;" @onclick="CreatePlanAsync">Save Plan</button>
</section>

<div class="kpi-grid">
    @foreach (var p in _plans)
    {
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="badge badge-blue">@p.BillingInterval</span>
                <span class="badge badge-green">@p.ActiveMemberCount active</span>
            </div>
            <h3 style="margin:0.6rem 0 0.25rem;">@p.Name</h3>
            <div style="font-size:1.75rem; font-weight:700; color:var(--brand-primary);">$@p.Price.ToString("N2")</div>
            <p style="color:var(--text-secondary); font-size:0.86rem; min-height:2.4rem;">@p.Description</p>
            <div style="font-size:0.8rem; color:var(--text-secondary);">
                Classes Included: <strong>@(p.IncludesClasses ? "Yes" : "No")</strong>
            </div>
        </div>
    }
</div>

@code {
    private List<MembershipPlanDto> _plans = [];
    private string _name = string.Empty;
    private string _description = string.Empty;
    private decimal _price = 59.00m;
    private BillingInterval _interval = BillingInterval.Monthly;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try { _plans = await Api.GetPlansAsync() ?? []; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task CreatePlanAsync()
    {
        _error = _message = null;
        try
        {
            await Api.CreatePlanAsync(new UpsertMembershipPlanRequest(_name, _description, _price, "USD", _interval));
            _name = _description = string.Empty;
            _message = "Membership plan created.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
