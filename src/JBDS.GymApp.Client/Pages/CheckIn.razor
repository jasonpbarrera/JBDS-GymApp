@page "/checkin"
@attribute [Authorize]
@implements IAsyncDisposable
@inject GymApiClient Api
@inject IJSRuntime JS

<PageTitle>QR &amp; Barcode Check-In — JBDS GymApp</PageTitle>

<h1 style="margin-top:0; font-size:1.5rem;">Front Desk QR / Barcode Check-In</h1>

<section class="card" style="margin-bottom:1.25rem;">
    <p style="margin-top:0; color:var(--text-secondary); font-size:0.9rem;">
        Use the live camera scanner, a USB barcode reader, or type a member's QR code / barcode / email to validate membership status and log check-in.
    </p>
    <div style="display:flex; gap:0.65rem; flex-wrap:wrap;">
        <input class="input" style="flex:1; min-width:240px;" @bind="_code" placeholder="e.g. GYM-IR-1001 or barcode or email" />
        <select class="select" style="width:180px;" @bind="_method">
            @foreach (var m in Enum.GetValues<CheckInMethod>())
            {
                <option value="@m">@m</option>
            }
        </select>
        <button class="btn btn-primary" @onclick="ScanAsync">Check In Member</button>
        <button class="btn btn-secondary" @onclick="ToggleCameraAsync">
            @(_cameraActive ? "Stop Camera" : "Scan with Camera")
        </button>
    </div>

    @if (_cameraActive)
    {
        <div style="margin-top:1rem; text-align:center;">
            <video id="qr-camera-video" playsinline muted style="width:100%; max-width:420px; border-radius:10px; border:2px solid var(--brand-primary); background:#000;"></video>
            <div style="font-size:0.8rem; color:var(--text-secondary); margin-top:0.35rem;">@_cameraStatus</div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_cameraStatus))
    {
        <div style="font-size:0.82rem; color:var(--text-secondary); margin-top:0.65rem;">@_cameraStatus</div>
    }

    @if (_lastResult is not null)
    {
        <div class="alert @(_lastResult.Allowed ? "alert-success" : "alert-error")" style="margin-top:1rem; margin-bottom:0;">
            <strong>@(_lastResult.Allowed ? "ACCESS GRANTED" : "ACCESS DENIED"):</strong> @_lastResult.Message
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-error" style="margin-top:1rem; margin-bottom:0;">@_error</div>
    }
</section>

<section class="card">
    <h2 style="margin-top:0; font-size:1.05rem;">Recent Check-In Log</h2>
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Member</th><th>Email</th><th>Method</th><th>Status</th><th>Time (UTC)</th></tr>
            </thead>
            <tbody>
                @foreach (var c in _checkIns)
                {
                    <tr>
                        <td style="font-weight:600;">@c.MemberName</td>
                        <td>@c.MemberEmail</td>
                        <td>@c.Method</td>
                        <td>
                            <span class="badge @(c.IsAllowed ? "badge-green" : "badge-red")">
                                @(c.IsAllowed ? "Allowed" : c.DenialReason ?? "Denied")
                            </span>
                        </td>
                        <td>@c.CheckedInAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private sealed record CameraStartResult(bool Supported, string Message);

    private List<CheckInDto> _checkIns = [];
    private CheckInResultDto? _lastResult;
    private string _code = string.Empty;
    private CheckInMethod _method = CheckInMethod.QrCode;
    private string? _error;

    private bool _cameraActive;
    private string? _cameraStatus;
    private DotNetObjectReference<CheckIn>? _dotNetRef;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try { _checkIns = await Api.GetCheckInsAsync() ?? []; }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ToggleCameraAsync()
    {
        if (_cameraActive)
        {
            await StopCameraAsync();
            return;
        }

        _cameraActive = true;
        _cameraStatus = "Starting camera...";
        StateHasChanged();
        await Task.Delay(60);

        _dotNetRef ??= DotNetObjectReference.Create(this);
        var res = await JS.InvokeAsync<CameraStartResult>("jbdsQrScanner.start", "qr-camera-video", _dotNetRef);
        _cameraStatus = res.Message;
        if (!res.Supported)
        {
            _cameraActive = false;
        }
    }

    private async Task StopCameraAsync()
    {
        _cameraActive = false;
        _cameraStatus = null;
        try { await JS.InvokeVoidAsync("jbdsQrScanner.stop"); } catch { }
    }

    [JSInvokable]
    public async Task OnBarcodeDetected(string scannedCode)
    {
        _code = scannedCode;
        _method = CheckInMethod.QrCode;
        await ScanAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ScanAsync()
    {
        _error = null;
        _lastResult = null;
        if (string.IsNullOrWhiteSpace(_code)) return;

        try
        {
            _lastResult = await Api.ScanCheckInAsync(new PerformCheckInRequest(_code.Trim(), null, _method));
            _code = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        await StopCameraAsync();
        _dotNetRef?.Dispose();
    }
}
